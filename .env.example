# Supabase database config.
# 1. Create a project at https://supabase.com
# 2. Run the SQL in `supabase.sql` (Dashboard > SQL Editor) to create the tables.
# 3. Copy your project URL and the **anon / public** API key (Project Settings >
#    API > Project API keys > `anon` `public`), fill these in, and rename this
#    file to ".env".
#
# Use the anon key (NOT service_role): this is a front-end app, so the key ships
# to the browser. RLS policies in supabase.sql govern what the anon key can do.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_KEY=your_supabase_api_key_here

# WalletConnect Cloud project id — required for mobile wallet login (QR on
# desktop, wallet list + deep links on phones). Get one free at
# https://cloud.walletconnect.com (Create project > copy the Project ID).
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here
